{
	"name": "stepstone",
	"displayName": "Stepstone",
	"version": "0.9.2",
	"description": "A shared roadmap of project goals for coding agents and the humans working beside them.",
	"author": {
		"name": "Max Miller"
	},
	"homepage": "https://github.com/max-miller1204/stepstone#readme",
	"repository": "https://github.com/max-miller1204/stepstone.git",
	"license": "MIT",
	"keywords": [
		"worklist",
		"roadmap",
		"goals",
		"tasks",
		"cli",
		"agent",
		"claude-code",
		"claude-code-plugin",
		"mcp",
		"pi-package",
		"pi",
		"extension"
	],
	"mcpServers": {
		"stepstone": {
			"command": "node",
			"args": [
				"${CLAUDE_PLUGIN_ROOT}/dist/mcp.js"
			],
			"env": {
				"STEPSTONE_PLUGIN_PROJECT_ROOT": "${CLAUDE_PROJECT_DIR}"
			}
		}
	}
}
