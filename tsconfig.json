{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
	// `alias` is a separately published package that resolves this one from the
	// registry, so it cannot typecheck against this checkout and is excluded here
	// rather than merely left out of `include`.
	"exclude": ["node_modules", "dist", "alias"]
}
