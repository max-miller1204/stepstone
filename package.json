{
	"name": "stepstone",
	"version": "0.12.0",
	"description": "A shared roadmap of project goals for coding agents and the humans working beside them.",
	"type": "module",
	"keywords": [
		"worklist",
		"roadmap",
		"goals",
		"tasks",
		"cli",
		"agent",
		"claude-code",
		"pi-package",
		"pi",
		"extension"
	],
	"author": "Max Miller",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/max-miller1204/stepstone.git"
	},
	"homepage": "https://github.com/max-miller1204/stepstone#readme",
	"bugs": {
		"url": "https://github.com/max-miller1204/stepstone/issues"
	},
	"files": [
		"src",
		"dist",
		"docs",
		"!docs/ROADMAP.md",
		"!docs/development.md",
		"!docs/releasing.md",
		".claude/skills/stepstone",
		"README.md",
		"package.json"
	],
	"bin": {
		"stepstone": "dist/cli.js"
	},
	"main": "./src/extension.ts",
	"exports": {
		".": "./src/extension.ts",
		"./src/*": "./src/*",
		"./package.json": "./package.json"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"scripts": {
		"worklist": "node ./src/cli.ts",
		"demo:screenshots": "node ./scripts/create-screenshot-demo.ts",
		"screenshots:update": "node ./scripts/update-screenshots.ts",
		"videos:list": "node ./scripts/videos/run.mjs list",
		"videos:check": "node ./scripts/videos/run.mjs check",
		"videos:render": "node ./scripts/videos/run.mjs render",
		"videos:test": "node --test scripts/videos/contract.test.mjs scripts/videos/run.test.mjs",
		"build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
		"docs": "node ./scripts/generate-docs.ts",
		"docs:check": "node ./scripts/generate-docs.ts --check",
		"imports:check": "node ./scripts/cli-import-graph.ts",
		"no-pi-install:check": "node ./scripts/no-pi-install-check.ts",
		"hooks:install": "lefthook install",
		"quality:pre-commit": "node ./scripts/quality-gates.ts pre-commit",
		"quality:pre-push": "node ./scripts/quality-gates.ts pre-push",
		"quality:push:worktree": "npm run check && npm run pack:check && npm run no-pi-install:check && npm run test:e2e:fast",
		"quality:static": "npm run typecheck && npm run imports:check && npm run lint:check && npm run docs:check",
		"prepack": "npm run build",
		"preversion": "npm run docs:check",
		"test": "npm run test:coverage",
		"test:boundaries": "vitest run test/process-boundaries.test.ts test/workspace-cleanup.test.ts",
		"test:coverage": "vitest run --coverage && node ./scripts/coverage-ratchet.ts",
		"test:coverage:update": "vitest run --coverage && node ./scripts/coverage-ratchet.ts --update",
		"test:mutation": "node ./scripts/mutation-check.ts",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"check": "npm run typecheck && npm run imports:check && biome check . && npm run test && npm run videos:test",
		"pack:check": "npm pack --dry-run",
		"verify": "npm run check && npm run pack:check && npm run test:mutation",
		"test:e2e": "node ./scripts/e2e-check.ts",
		"test:e2e:fast": "node ./scripts/e2e-check.ts --fast"
	},
	"dependencies": {
		"proper-lockfile": "^4.1.2",
		"zod": "^4.4.3"
	},
	"bundledDependencies": [
		"proper-lockfile",
		"zod"
	],
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@resvg/resvg-js": "2.6.2",
		"@types/node": "^24.0.0",
		"@types/proper-lockfile": "^4.1.4",
		"@vitest/coverage-v8": "^4.1.10",
		"@xterm/headless": "6.0.0",
		"lefthook": "^2.1.10",
		"typebox": "*",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=20"
	}
}
