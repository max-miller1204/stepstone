{
	"name": "pi-worklist",
	"version": "0.17.0",
	"description": "Deprecated alias for stepstone. Install stepstone instead; this package only forwards to it.",
	"type": "module",
	"keywords": [
		"pi",
		"extension",
		"worklist",
		"tasks",
		"goals",
		"deprecated"
	],
	"author": "Max Miller",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/max-miller1204/stepstone.git",
		"directory": "alias/pi-worklist"
	},
	"homepage": "https://github.com/max-miller1204/stepstone#renamed-from-pi-worklist",
	"bugs": {
		"url": "https://github.com/max-miller1204/stepstone/issues"
	},
	"files": [
		"bin",
		"src",
		"README.md",
		"package.json"
	],
	"bin": {
		"pi-worklist": "bin/pi-worklist.js"
	},
	"main": "./src/extension.ts",
	"exports": {
		".": "./src/extension.ts",
		"./package.json": "./package.json"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"dependencies": {
		"stepstone": ">=0.17.0"
	},
	"engines": {
		"node": ">=20"
	}
}
