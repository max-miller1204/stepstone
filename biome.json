{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!.git",
			"!.pi-subagents",
			"!.pi",
			"!.worklist",
			"!artifacts",
			"!coverage",
			"!dist",
			"!.no-mistakes"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 110
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
