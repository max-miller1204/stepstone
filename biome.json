{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!.git",
			"!.pi-subagents",
			"!.pi",
			"!.worklist",
			"!dist",
			"!.no-mistakes"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 110
	},
	"overrides": [
		{
			"includes": [".claude-plugin/*.json"],
			"formatter": {
				"enabled": false
			}
		}
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
